# postgres (used by backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=raguser
DB_PASS=ragpass
DB_NAME=ragdb

# postgres docker initialization (used by postgres container)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM provider
LLM_PROVIDER=groq

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# file storage
UPLOAD_DIR=./uploads

# embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# retrieval
TOP_K=8

# auth
JWT_SECRET=your-secret-key-here
JWT_EXPIRY_HOURS=24
